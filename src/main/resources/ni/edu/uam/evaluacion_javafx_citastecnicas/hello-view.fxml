<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.evaluacion_javafx_citastecnicas.HelloController"
            styleClass="app-root">
  <top>
    <VBox spacing="10" styleClass="app-header">
      <Label text="TecnoAsistencia Nicaragua S.A." styleClass="app-title" />
      <Label text="Sistema de gestión de citas de atención técnica" styleClass="app-subtitle" />
      <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Clientes" onAction="#mostrarClientes" styleClass="nav-button" />
        <Button text="Citas técnicas" onAction="#mostrarCitas" styleClass="nav-button" />
        <Button text="Reintentar conexión" onAction="#reintentarConexion" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblEstado" text="Comprobando conexión..." styleClass="status" />
      </HBox>
    </VBox>
  </top>
  <center><StackPane fx:id="contenedor" styleClass="main-content" /></center>
</BorderPane>
